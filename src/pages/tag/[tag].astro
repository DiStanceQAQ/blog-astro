---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArrowIcon from '../../components/ArrowIcon.astro';
import { getPublishedPosts, postHref, splitDate, uniqueTags, type Post } from '../../lib/posts';

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return uniqueTags(posts).map((tag) => ({ params: { tag }, props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) } }));
}) satisfies GetStaticPaths;
interface Props { tag: string; posts: Post[] }
const { tag, posts } = Astro.props;
---
<BaseLayout title={`#${tag}`} description={`标记为${tag}的文章`}>
  <div class="page-shell taxonomy-detail">
    <a class="back-link" href="/categories#tags"><ArrowIcon direction="left" />返回标签</a>
    <header class="page-intro"><h1>#{tag}</h1><p>{posts.length} 篇文章，按发布时间排列。</p></header>
    <section class="archive-section">
      {posts.map((post) => { const date = splitDate(post.data.date); return (
        <article class="archive-row"><time class="archive-date"><span class="year">{date.year}</span><span class="short">{date.short}</span></time><div class="archive-copy"><span class="category">{post.data.category}</span><h2><a href={postHref(post)}>{post.data.title}</a></h2><p>{post.data.description}</p></div><a class="archive-arrow" href={postHref(post)} aria-label={`阅读${post.data.title}`}><ArrowIcon /></a></article>
      ); })}
    </section>
  </div>
</BaseLayout>
